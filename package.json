{
  "name": "opencode-task-model-router",
  "version": "1.3.0",
  "description": "OpenCode plugin for cost-aware task delegation across configurable model tiers",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "cross-env RUN_OC_SMOKE=1 vitest run --config vitest.smoke.config.ts test/smoke",
    "typecheck": "tsc --noEmit"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s3tupw1zard/opencode-task-model-router.git"
  },
  "homepage": "https://github.com/s3tupw1zard/opencode-task-model-router",
  "bugs": {
    "url": "https://github.com/s3tupw1zard/opencode-task-model-router/issues"
  },
  "author": {
    "name": "s3tupw1zard",
    "url": "https://github.com/s3tupw1zard"
  },
  "contributors": [
    {
      "name": "Marco Jardim",
      "url": "https://github.com/marco-jardim"
    }
  ],
  "keywords": [
    "opencode",
    "plugin",
    "model-routing",
    "task-routing",
    "subagents",
    "delegation",
    "multi-model",
    "orchestration"
  ],
  "files": [
    "src/",
    "tiers.json",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
