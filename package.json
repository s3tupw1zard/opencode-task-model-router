{
  "name": "@s3tupw1zard/opencode-task-model-router",
  "version": "1.0.0-beta.1",
  "description": "OpenCode plugin for cost-aware task delegation across configurable model tiers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "cross-env RUN_OC_SMOKE=1 vitest run --config vitest.smoke.config.ts test/smoke",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s3tupw1zard/opencode-task-model-router.git"
  },
  "homepage": "https://github.com/s3tupw1zard/opencode-task-model-router",
  "bugs": {
    "url": "https://github.com/s3tupw1zard/opencode-task-model-router/issues"
  },
  "author": {
    "name": "s3tupw1zard",
    "url": "https://github.com/s3tupw1zard"
  },
  "contributors": [
    {
      "name": "Marco Jardim",
      "url": "https://github.com/marco-jardim"
    }
  ],
  "keywords": [
    "opencode",
    "plugin",
    "model-routing",
    "task-routing",
    "subagents",
    "delegation",
    "multi-model",
    "orchestration"
  ],
  "files": [
    "dist/",
    "tiers.json",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.11",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^7.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
